{
  "restore_on_startup": "launchpad",
  "cursor_blink": false,
  "autosave": "on_focus_change",
  "ui_font_size": 13.0,
  "format_on_save": "on",
  "close_panel_on_toggle": false,
  "focus_follows_mouse": {},
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_line_height": {
    "custom": 2.0,
  },
  "code_lens": "off",
  "vim_mode": true,
  "cursor_animation": {
    "enabled": true,
  },
  "auto_signature_help": false,
  "window_title_format": "${projectName}${separator}${fileName}",
  "markdown_preview": {
    "font_size": 12.0,
  },
  "auto_update": true,
  "tab_size": 2,
  "disable_ai": true,
  "buffer_font_weight": 400.0,
  "redact_private_values": false,
  "use_system_window_tabs": false,
  "close_on_file_delete": true,
  "completion_menu_item_kind": "symbol",
  "autoscroll_on_clicks": true,
  "show_whitespaces": "selection",
  "status_bar": {
    "show_active_file": false,
    "line_endings_button": true,
    "active_encoding_button": "enabled",
    "active_language_button": true,
    "cursor_position_button": true,
  },
  "buffer_font_size": 12.0,
  "icon_theme": "Symbols Icon Theme",
  "theme": "Truly Zen Dark",
  "which_key": {
    "delay_ms": 0,
    "enabled": true,
  },
  "auto_indent_on_paste": true,
  "hover_popover_enabled": true,
  "show_wrap_guides": true,
  "gutter": {
    "line_numbers": true,
    "min_line_number_digits": 4,
  },
  "debugger": {
    "dock": "left",
  },
  "instrumentation": {
    "performance_profiler": {
      "enabled": false,
    },
  },
  "proxy": "",
  "indent_guides": {
    "line_width": 1,
    "coloring": "fixed",
    "background_coloring": "disabled",
  },
  "go_to_definition_scroll_strategy": "center",
  "current_line_highlight": "all",
  "cli_default_open_behavior": "existing_window",
  "collaboration_panel": {
    "default_width": 300.0,
    "dock": "left",
  },
  "agent_servers": {
    "opencode": {
      "type": "registry",
    },
  },
  "outline_panel": {
    "file_icons": true,
    "dock": "left",
    "indent_size": 15.0,
    "indent_guides": {
      "show": "never",
    },
  },
  "restore_on_file_reopen": true,
  "search": {
    "center_on_match": true,
    "regex": false,
  },
  "use_smartcase_search": false,
  "file_finder": {
    "file_icons": true,
    "modal_max_width": "small",
  },
  "show_edit_predictions": true,
  "text_rendering_mode": "platform_default",
  "selection_highlight": true,
  "vim": {
    "toggle_relative_line_numbers": true,
    "use_smartcase_find": true,
    "cursor_shape": {},
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "inlayHints": {
          "maxLength": null,
          "lifetimeElisionHints": {
            "enable": "skip_trivial",
            "useParameterNames": true,
          },
          "closureReturnTypeHints": {
            "enable": "always",
          },
        },
      },
    },
  },
  "languages": {
    "Markdown-Inline": {
      "soft_wrap": "none",
    },
    "Python": {
      "tab_size": 4,
    },
    "Go": {
      "tab_size": 4,
    },
    "Java": {
      "tab_size": 2,
    },
    "Rust": {
      "tab_size": 4,
    },
  },
  "prettier": {},
  "buffer_font_features": {
    //jetbrains mono
    "zero": true, //0
    "cv02": true, //t
    "cv07": true, //w
    "cv08": true, //k
    "cv14": true, //$
    "cv17": true, //f

    //geist mono
    "ss11": true,

    //     //monaspace neon
    //     "calt": true,
    //     "liga": true,
    //     "ss01": true,
    //     "ss02": true,
    //     "ss03": true,
    //     "ss04": true,
    //     "ss05": true,
    //     "ss06": true,
    //     "ss07": true,
    //     "ss08": true,
    //     "ss09": true,
    //     "ss10": true,
    //     "cv30": true,
    //     "cv31": true,
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "agent_review": true,
    "selections_menu": true,
  },
  "diagnostics": {
    "button": true,
    "inline": {
      "enabled": true,
    },
  },
  "inlay_hints": {
    "show_background": false,
    "enabled": false,
  },
  "agent_ui_font_size": 12.0,
  "session": {
    "trust_all_worktrees": true,
    "restore_unsaved_buffers": true,
  },
  "scrollbar": {
    "git_diff": true,
    "search_results": true,
  },
  "confirm_quit": true,
  "git": {
    "blame": {
      "show_avatar": true,
    },
    "disable_git": false,
    "inline_blame": {
      "enabled": false,
      "show_commit_summary": false,
      "padding": 7,
      "location": "status_bar",
    },
  },
  "zoomed_padding": true,
  "active_pane_modifiers": {},
  "terminal": {
    "default_height": 300.0,
    "cursor_shape": "bar",
    "working_directory": null,
    "font_family": "JetBrainsMono Nerd Font",
    "default_width": 450.0,
    "flexible": false,
    "show_count_badge": false,
    "dock": "bottom",
    "minimum_contrast": 45.0,
    "font_size": 12.0,
    "shell": "system",
    "toolbar": {},
    "copy_on_select": true,
    "button": true,
  },
  "on_last_window_closed": "platform_default",
  "edit_predictions": {
    "open_ai_compatible_api": {
      "prompt_format": "zeta",
    },
    "copilot": {
      "enable_next_edit_suggestions": true,
    },
    "mode": "subtle",
    "provider": "zed",
  },
  "agent": {
    "threads_sidebar": {
