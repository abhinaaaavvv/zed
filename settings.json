{
  "buffer_line_height": {
    "custom": 2.0,
  },
  "buffer_font_size": 12.0,
  "vertical_scroll_margin": 8.0,
  "accessible_mode": true,
  "tasks": {},
  "soft_wrap": "editor_width",
  "diff_view_style": "split",
  "bottom_dock_layout": "contained",
  "scroll_beyond_last_line": "vertical_scroll_margin",
  "fast_scroll_sensitivity": 4.0,
  "restore_on_startup": "launchpad",
  "autosave": "on_focus_change",
  "ui_font_size": 13.0,
  "format_on_save": "on",
  "focus_follows_mouse": {
    "enabled": false,
  },
  "code_lens": "off",
  "vim_mode": true,
  "cursor_animation": {
    "enabled": true,
  },
  "auto_signature_help": false,
  "window_title_format": "${projectName}${separator}${fileName}",
  "markdown_preview": {
    "font_size": 12.0,
  },
  "auto_update": true,
  "tab_size": 2,
  "disable_ai": true,
  "redact_private_values": false,
  "use_system_window_tabs": false,
  "close_on_file_delete": true,
  "completion_menu_item_kind": "symbol",
  "autoscroll_on_clicks": true,
  "show_whitespaces": "selection",
  "status_bar": {
    "active_encoding_button": "enabled",
    "line_endings_button": true,
    "show_active_file": true,
    "active_language_button": true,
    "cursor_position_button": true,
  },
  "icon_theme": "Symbols Icon Theme",
  "theme": "Truly Zen dark",
  "which_key": {
    "delay_ms": null,
    "enabled": true,
  },
  "auto_indent_on_paste": true,
  "hover_popover_enabled": true,
  "show_wrap_guides": true,
  "gutter": {
    "line_numbers": true,
    "min_line_number_digits": 4,
  },
  "debugger": {
    "dock": "left",
  },
  "instrumentation": {
    "performance_profiler": {
      "enabled": false,
    },
  },
  "proxy": "",
  "indent_guides": {
    "enabled": true,
    "background_coloring": "disabled",
  },
  "go_to_definition_scroll_strategy": "center",
  "current_line_highlight": "all",
  "cli_default_open_behavior": "existing_window",
  "collaboration_panel": {
    "default_width": 300.0,
    "dock": "left",
  },
  "agent_servers": {
    "opencode": {
      "type": "registry",
    },
  },
  "outline_panel": {
    "folder_indicator": "chevron",
    "file_icons": true,
    "dock": "left",
    "indent_size": 15.0,
    "indent_guides": {
      "show": "never",
    },
  },
  "restore_on_file_reopen": true,
  "search": {
    "center_on_match": true,
    "regex": false,
  },
  "use_smartcase_search": false,
  "file_finder": {
    "file_icons": true,
    "modal_max_width": "small",
  },
  "show_edit_predictions": true,
  "text_rendering_mode": "platform_default",
  "selection_highlight": true,
  "vim": {
    "highlight_on_yank_duration": 100,
    "toggle_relative_line_numbers": true,
    "use_smartcase_find": true,
    "cursor_shape": {},
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "inlayHints": {
          "maxLength": null,
          "lifetimeElisionHints": {
            "enable": "skip_trivial",
            "useParameterNames": true,
          },
          "closureReturnTypeHints": {
            "enable": "always",
          },
        },
      },
    },
  },
  "languages": {
    "Markdown-Inline": {
      "soft_wrap": "none",
    },
    "Python": {
      "tab_size": 4,
    },
    "Go": {
      "tab_size": 4,
    },
    "Java": {
      "tab_size": 4,
    },
    "Rust": {
      "tab_size": 4,
    },
  },
  "prettier": {},
  "buffer_font_features": {
    // //jetbrains mono
    // "zero": true, //0
    // "cv01": true, //l
    // "cv02": true, //t
    // "cv04": true, //j
    // "cv07": true, //w
    // "cv08": true, //k
    // "cv10": true, //r
    // "cv14": true, //$
    // "cv17": true, //f

    //geist mono
    "ss11": true,

    //.zedmono(lilex) or ibm plex mono
    "zero": true, //0
    "cv01": true, //a
    "cv02": true, //g
    "cv10": true, //*
    "salt": true, //style alt
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "agent_review": true,
    "selections_menu": true,
  },
  "diagnostics": {
    "button": true,
    "inline": {
      "enabled": true,
    },
  },
  "inlay_hints": {},
  "agent_ui_font_size": 12.0,
  "session": {
    "trust_all_worktrees": true,
    "restore_unsaved_buffers": true,
  },
  "scrollbar": {
    "axes": {
      "vertical": true,
    },
    "git_diff": true,
    "search_results": true,
  },
  "confirm_quit": true,
  "git": {
    "blame": {},
    "disable_git": false,
    "inline_blame": {
      "enabled": false,
      "padding": 7,
      "location": "status_bar",
    },
  },
  "zoomed_padding": true,
  "active_pane_modifiers": {},
  "terminal": {
    "font_family": "Lilex Nerd Font",
    "default_height": 300.0,
    "cursor_shape": "bar",
    "working_directory": null,
    "default_width": 450.0,
    "flexible": false,
    "show_count_badge": false,
    "dock": "bottom",
    "minimum_contrast": 45.0,
    "font_size": 12.0,
    "shell": "system",
    "toolbar": {},
    "copy_on_select": true,
    "button": true,
    "font_features": {
      //jetbrains mono
      // "zero": true, //0
      // "cv01": true, //l
      // "cv02": true, //t
      // "cv04": true, //j
      // "cv07": true, //w
      // "cv08": true, //k
      // "cv14": true, //$
      // "cv17": true, //f

      //geist mono
      "ss11": true,

      //.zedmono or ibm plex mono/blex mono
      "zero": true, //0
      "cv01": true, //a
      "cv02": true, //g
      "cv10": true, //*
      "salt": true, //style alt
    },
  },
  "on_last_window_closed": "platform_default",
  "edit_predictions": {
    "open_ai_compatible_api": {
      "prompt_format": "zeta",
    },
    "copilot": {
      "enable_next_edit_suggestions": true,
    },
    "mode": "subtle",
    "provider": "zed",
  },
  "agent": {
    "threads_sidebar": {
      "position": "right",
    },
    "default_width": 450.0,
    "button": true,
    "dock": "right",
    "terminal_init_command": "",
    "flexible": false,
    "favorite_models": [
      {
        "provider": "google",
        "model": "gemini-3-flash-preview",
        "enable_thinking": false,
      },
      {
        "provider": "google",
        "model": "gemini-3.1-pro-preview",
        "enable_thinking": true,
      },
      {
        "provider": "google",
        "model": "gemini-2.5-flash",
        "enable_thinking": false,
      },
      {
        "provider": "openrouter",
        "model": "stealth/ox-alpha",
        "enable_thinking": true,
      },
    ],
    "profiles": {},
    "enable_feedback": true,
    "tool_permissions": {
      "default": "allow",
    },
    "inline_assistant_model": {
      "provider": "openrouter",
      "model": "stealth/ox-alpha",
    },
    "default_profile": "ask",
    "default_model": {
      "enable_thinking": true,
      "provider": "openrouter",
      "model": "stealth/ox-alpha",
    },
    "model_parameters": [],
  },
  "helix_mode": false,
  "git_panel": {
    "default_width": 300.0,
    "fallback_branch_name": "main",
    "dock": "left",
    "tree_view": true,
    "collapse_untracked_diff": false,
  },
  "project_panel": {
    "hide_root": false,
    "default_width": 210.0,
    "indent_size": 15.0,
    "entry_spacing": "comfortable",
    "folder_indicator": "chevron",
    "dock": "left",
    "scrollbar": {},
    "diagnostic_badges": true,
    "indent_guides": {
      "show": "never",
    },
    "file_icons": true,
    "button": true,
    "hide_hidden": false,
    "hide_gitignore": false,
  },
  "centered_layout": {
    "right_padding": 0.2,
    "left_padding": null,
  },
  "preview_tabs": {
    "enabled": false,
    "enable_preview_file_from_code_navigation": false,
    "enable_preview_from_multibuffer": false,
    "enable_preview_from_project_panel": false,
  },
  "tabs": {
    "file_icons": true,
    "git_status": false,
    "show_diagnostics": "all",
  },
  "tab_bar": {
    "show_nav_history_buttons": true,
    "show_tab_bar_buttons": true,
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_user_menu": true,
    "show_onboarding_banner": true,
    "show_menus": false,
    "show_sign_in": true,
    "show_project_items": true,
  },
  "sticky_scroll": {},
  "minimap": {
    "current_line_highlight": "all",
    "max_width_columns": 80,
  },
}
