  "git_panel": {
    "default_width": 300.0,
    "fallback_branch_name": "main",
    "dock": "left",
    "tree_view": true,
    "collapse_untracked_diff": false,
  },
  "project_panel": {
    "hide_root": true,
    "default_width": 210.0,
    "indent_size": 15.0,
    "entry_spacing": "comfortable",
    "folder_indicator": "chevron",
    "dock": "left",
    "auto_fold_dirs": true,
    "git_status_indicator": true,
    "scrollbar": {},
    "bold_folder_labels": false,
    "diagnostic_badges": true,
    "indent_guides": {
      "show": "never",
    },
    "file_icons": true,
    "button": true,
    "hide_hidden": false,
    "hide_gitignore": false,
  },
  "centered_layout": {
    "right_padding": 0.2,
    "left_padding": 0.2,
