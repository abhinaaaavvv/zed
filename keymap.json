[
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j k": "vim::NormalBefore",
      "j j": "vim::NormalBefore",
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "l": "project_panel::CollapseSelectedEntry",
      "h": "project_panel::ExpandSelectedEntry",
    },
  },
  {
    "context": "(vim_mode == insert || (VimControl && !menu))",
    "bindings": { "alt-a": "editor::ToggleCodeActions" },
  },
  {
    "context": "(Editor && edit_prediction)",
    "bindings": { "tab": "editor::AcceptEditPrediction" },
  },
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      "g w": "vim::HelixJumpToWord",
      "space w": "pane::CloseActiveItem",
      "space r": "projects::OpenRecent",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "alt-h": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "left" },
      ],
      "alt-l": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "right" },
      ],
      "alt-k": ["workspace::MoveItemToPaneInDirection", { "direction": "up" }],
      "alt-j": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "down" },
      ],
    },
  },
  {
    "context": "Workspace",
    "bindings": {},
  },
]
